---
import ArticleItem from "@/components/article-item.astro";
import Pattern from "@/components/ui/pattern.astro";
import type { Locale } from "@/lib/i18n";
import { getLocaleConfig } from "@/lib/locale-content";
import { getMessages } from "@/lib/messages";
import {
  getArticleSeries,
  getMergedSortedArticles,
} from "@/lib/list-articles";
import PageLayout from "./page-layout.astro";
import Box from "@/components/box/index.astro";
import BoxHeader from "@/components/box/header.astro";
import BoxTitle from "@/components/box/title.astro";

interface Props {
  locale: Locale;
  series: string;
}

const { locale, series } = Astro.props;
const { articles: articleMessages, seriesDescription } = getMessages(locale);
const { blogCollection: collectionName, articlesBasePath: baseLink } =
  getLocaleConfig(locale);
const title = series;
const description = seriesDescription(series);
const { articlesTitle } = articleMessages;

const merged = await getMergedSortedArticles(collectionName, locale);
const seiriesArticles = merged.filter(
  article => getArticleSeries(article) === series,
);
---

<PageLayout backLink={baseLink} description={description} title={title}>
  <Pattern />

  <Box>
    <BoxHeader>
      <BoxTitle>{articlesTitle}</BoxTitle>
    </BoxHeader>
    <div
      class="flex w-full flex-col items-start justify-start divide-y divide-border"
    >
      {seiriesArticles.map(article => <ArticleItem article={article} />)}
    </div>
  </Box>
</PageLayout>
