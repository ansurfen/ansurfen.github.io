---
import Pattern from "@/components/ui/pattern.astro";
import PageLayout from "@/layouts/page-layout.astro";
import Box from "@/components/box/index.astro";
import BoxHeader from "@/components/box/header.astro";
import BoxTitle from "@/components/box/title.astro";
import ProjectItem from "@/components/sections/projects/project-item.astro";
import type { Locale } from "@/lib/i18n";
import { getLocaleConfig } from "@/lib/locale-content";
import { getMessages } from "@/lib/messages";
import { getMergedProjects, getProjectType } from "@/lib/list-projects";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { title, description, coreTitle, sideTitle } = getMessages(locale).projects;
const { projectCollection: collectionName } = getLocaleConfig(locale);

const projects = await getMergedProjects(collectionName, locale);
const coreProjects = projects.filter(p => getProjectType(p) === "core");
const sideProjects = projects.filter(p => getProjectType(p) === "side");
---

<PageLayout description={description} title={title}>
  <Pattern />
  <Box>
    <BoxHeader>
      <BoxTitle>{coreTitle}</BoxTitle>
    </BoxHeader>

    {coreProjects.map(item => <ProjectItem project={item} />)}
  </Box>

  {
    sideProjects.length > 0 && (
      <>
        <Pattern />
        <Box>
          <BoxHeader>
            <BoxTitle>{sideTitle}</BoxTitle>
          </BoxHeader>
          {sideProjects.map(item => <ProjectItem project={item} />)}
        </Box>
      </>
    )
  }

  <Pattern />
</PageLayout>
