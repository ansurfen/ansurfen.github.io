---
import { ChevronRightIcon, FolderCodeIcon, Lock } from "lucide-react";
import MarkdownRenderer from "@/components/ui/markdown-renderer.astro";
import Badge from "@/components/ui/badge.astro";
import { getLocale, getLocalePathByString } from "@/lib/i18n";
import type { ListProject } from "@/lib/list-projects";
import { isPrivateProjectEntry } from "@/lib/private-manifest";

interface Props {
  project: ListProject;
}

const { project } = Astro.props;
const locale = getLocale(Astro.url);

const isPrivate = project.kind === "private";
const projectId =
  project.kind === "public" ? project.entry.id : project.entry.id;

const name =
  project.kind === "public"
    ? project.entry.data.name
    : isPrivateProjectEntry(project.entry)
      ? project.entry.meta.name
      : "";

const description =
  project.kind === "public"
    ? project.entry.data.description
    : isPrivateProjectEntry(project.entry)
      ? project.entry.meta.description
      : "";

const technologies =
  project.kind === "public"
    ? project.entry.data.technologies
    : isPrivateProjectEntry(project.entry)
      ? project.entry.meta.technologies
      : [];
---

<a
  href={getLocalePathByString(locale, `/projects/${projectId}`)}
  class="flex cursor-pointer items-center not-last:border-b"
>
  {
    isPrivate ? (
      <Lock className="mx-4.5 size-5 shrink-0 text-muted-foreground" />
    ) : (
      <FolderCodeIcon className="mx-4.5 size-5 shrink-0 text-muted-foreground" />
    )
  }
  <div class="group flex w-full cursor-pointer flex-col gap-y-3 border-l p-4">
    <div class="flex w-full items-center justify-between text-left select-none">
      <h3
        class="text-lg font-semibold underline-offset-6 group-hover:underline"
      >
        {name}
      </h3>

      <ChevronRightIcon
        className="size-4 shrink-0 text-muted-foreground transition-transform duration-150 group-hover:translate-x-1"
      />
    </div>

    <MarkdownRenderer
      className="text-xs leading-5 font-medium md:text-sm"
      content={description}
    />

    {
      technologies.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {technologies.map(technology => (
            <Badge>{technology}</Badge>
          ))}
        </div>
      )
    }
  </div>
</a>
