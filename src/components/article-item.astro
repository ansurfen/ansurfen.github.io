---
import { getLocale, getLocalePathByString, getTimeLocale } from "@/lib/i18n";
import type { ListArticle } from "@/lib/list-articles";
import { getArticleSlug } from "@/lib/list-articles";
import { isPrivateBlogEntry, toPubDate } from "@/lib/private-manifest";
import { ChevronRightIcon, Lock, NotebookPen } from "lucide-react";
import getReadingTime from "reading-time";

interface Props {
  article: ListArticle;
}

const { article } = Astro.props;
const locale = getLocale(Astro.url);
const slug = getArticleSlug(article);

const isPrivate = article.kind === "private";
const privateBlog =
  article.kind === "private" && isPrivateBlogEntry(article.entry)
    ? article.entry
    : undefined;

const title =
  article.kind === "public"
    ? article.entry.data.title
    : privateBlog!.meta.title;
const tags =
  article.kind === "public" ? article.entry.data.tags : privateBlog!.meta.tags;
const pubDate =
  article.kind === "public"
    ? article.entry.data.pubDatetime
    : toPubDate(privateBlog!.meta.pubDatetime);

const formattedDate = new Intl.DateTimeFormat(getTimeLocale(locale), {
  day: "2-digit",
  month: "short",
  year: "numeric",
}).format(pubDate);

const readTimeLabel =
  article.kind === "public"
    ? getReadingTime(article.entry.body!).text
    : "加密";
---

<a
  href={getLocalePathByString(locale, `/articles/${slug}`)}
  class="group flex w-full cursor-pointer items-center"
>
  {
    isPrivate ? (
      <Lock className="mx-5 size-5 shrink-0 text-muted-foreground" />
    ) : (
      <NotebookPen className="mx-5 size-5 shrink-0 text-muted-foreground" />
    )
  }

  <div
    class="flex flex-1 flex-col items-start justify-center gap-3 border-l p-4"
  >
    <div class="flex w-full items-center justify-between text-left select-none">
      <h3
        class="text-lg font-semibold underline-offset-6 group-hover:underline"
      >
        {title}
      </h3>

      <ChevronRightIcon
        className="size-4 shrink-0 text-sm text-muted-foreground transition-transform duration-150 group-hover:translate-x-1"
      />
    </div>

    <ul class="flex flex-wrap items-center justify-start gap-x-4">
      {
        tags.map((tag: string) => (
          <li class="text-xs font-semibold">#{tag}</li>
        ))
      }
    </ul>
    <p class="text-xs text-foreground">
      {formattedDate} | {readTimeLabel}
    </p>
  </div>
</a>
