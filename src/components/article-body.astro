---
import { render } from "astro:content";
import VaultArticle from "@/components/vault-article";
import type { ArticleSlugPageProps } from "@/lib/i18n-page-types";
import type { Locale } from "@/lib/i18n";
import { getMessages } from "@/lib/messages";
import { getPrivateVaultUrl, isPrivateBlogEntry } from "@/lib/private-manifest";

interface Props extends ArticleSlugPageProps {
  locale: Locale;
}

const { post, privateEntry, locale } = Astro.props;
const vaultMessages = getMessages(locale).vault;

let Content: Awaited<ReturnType<typeof render>>["Content"] | null = null;

if (post) {
  const rendered = await render(post);
  Content = rendered.Content;
}

const privateBlog =
  privateEntry && isPrivateBlogEntry(privateEntry) ? privateEntry : undefined;
---

{
  privateBlog ? (
    <VaultArticle
      client:load
      vaultUrl={getPrivateVaultUrl(privateBlog.vaultFile)}
      messages={vaultMessages}
    />
  ) : (
    Content && <Content />
  )
}
