---
import { getCategoryPaths } from "@/lib/articles";
import CategoryLayout from "@/layouts/category-layout.astro";
import type { LocalePageProps } from "@/lib/i18n-page-types";

export async function getStaticPaths() {
  const paths = await getCategoryPaths("blog");

  return paths.map((path) => ({
    params: path.params,
    props: { locale: "en_us" as const },
  }));
}

export type Props = LocalePageProps;

const { locale } = Astro.props;
const { category } = Astro.params;
---

<CategoryLayout locale={locale} category={category!} />
