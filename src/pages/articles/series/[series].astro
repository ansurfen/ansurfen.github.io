---
import { getSeriesPaths } from "@/lib/articles";
import SeriesLayout from "@/layouts/series-layout.astro";
import type { LocalePageProps } from "@/lib/i18n-page-types";

export async function getStaticPaths() {
  const paths = await getSeriesPaths("blog");

  return paths.map((path) => ({
    params: path.params,
    props: { locale: "en_us" as const },
  }));
}

export type Props = LocalePageProps;

const { locale } = Astro.props;
const { series } = Astro.params;
---

<SeriesLayout locale={locale} series={series!} />
